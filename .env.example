# Configuración opcional para sincronización en la nube con Supabase (100% gratuita)
# Si no se definen, la aplicación funciona de forma autónoma con almacenamiento local y sync entre pestañas.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ========================================================
# EVIDENCIAS FOTOGRÁFICAS EN RETOS — GOOGLE DRIVE PRIVADO
# ========================================================
# 1. Email de la Cuenta de Servicio (Service Account) generado en Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# 2. Clave privada RSA descargada en el JSON de la Service Account (incluyendo comillas y saltos de línea \n)
GOOGLE_PRIVATE_KEY=

# 3. ID de la carpeta en tu Google Drive personal donde la Service Account tiene permiso de 'Editor'
GOOGLE_DRIVE_FOLDER_ID=
